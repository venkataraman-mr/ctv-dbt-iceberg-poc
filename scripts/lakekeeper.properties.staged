# Trino catalog: connect Trino -> Lakekeeper (Iceberg REST) for the catalog PoC.
# Drop into infra/trino/catalog/ as `lakekeeper.properties`, then `docker compose up -d trino`.
# Wire this only AFTER scripts/lakekeeper_bootstrap.sh has created the `ctv_lakekeeper` warehouse.

connector.name=iceberg
iceberg.catalog.type=rest

# Lakekeeper Iceberg REST endpoint. Internal Docker hostname `lakekeeper`, container port 8181, /catalog path.
# (External Databricks uses http://<VM>:8282/catalog — different host port, same /catalog path.)
iceberg.rest-catalog.uri=http://lakekeeper:8181/catalog

# The Lakekeeper warehouse name created at bootstrap (the REST "warehouse").
iceberg.rest-catalog.warehouse=ctv_lakekeeper

# Unsecured Lakekeeper (no OpenID in this PoC): send a static bearer token; any value is accepted.
# If we later enable OpenID auth, switch to oauth2.credential + a token endpoint like the Polaris catalog.
iceberg.rest-catalog.security=OAUTH2
iceberg.rest-catalog.oauth2.token=dummy

# STORAGE: Lakekeeper controls S3 access via the warehouse's storage-credential (access-key, STS off -> remote
# signing). Let Trino take the catalog-managed credentials rather than using its own keys.
iceberg.rest-catalog.vended-credentials-enabled=true
fs.native-s3.enabled=true
s3.region=us-east-2

# Fallback if Lakekeeper remote-signing isn't honored by this Trino build: comment vended-credentials above and
# provide Trino's own keys (AWS_* env already in the container), same as the Nessie `iceberg` catalog:
#   (remove the vended-credentials line; fs.native-s3 + s3.region already present)
