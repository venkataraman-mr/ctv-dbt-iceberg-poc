# Trino catalog: connect Trino -> Apache Polaris (Iceberg REST) for the catalog PoC.
# Drop into infra/trino/catalog/ (or the PoC Trino's catalog dir) as `polaris.properties`, then
# `docker compose up -d trino`. Values come from your Polaris bootstrap (see docs/catalog/catalog_poc_runbook.md).
#
# Polaris auth = OAuth2 client-credentials using a Polaris *principal's* client id + secret.
# Polaris can VEND S3 credentials, so Trino needs no S3 keys (this also tests credential vending).

connector.name=iceberg
iceberg.catalog.type=rest

# Polaris Iceberg REST endpoint. In-container hostname `polaris` (same compose network); /api/catalog path.
iceberg.rest-catalog.uri=http://polaris:8181/api/catalog

# The Polaris catalog name created at bootstrap (the REST "warehouse"). We create `ctv_poc`.
iceberg.rest-catalog.warehouse=ctv_poc

# OAuth2 (client credentials). credential = "<client-id>:<client-secret>" of a Polaris principal.
# Kept out of git: Trino reads it from the POLARIS_OAUTH2_CREDENTIAL env (set in .env, passed via compose),
# same pattern as postgres.properties / unity_catalog.properties. Value = the trino_poc creds from bootstrap.
iceberg.rest-catalog.security=OAUTH2
iceberg.rest-catalog.oauth2.credential=${ENV:POLARIS_OAUTH2_CREDENTIAL}
iceberg.rest-catalog.oauth2.scope=PRINCIPAL_ROLE:ALL
# If the token endpoint isn't the default {uri}/v1/oauth/tokens, set it explicitly:
# iceberg.rest-catalog.oauth2.server-uri=http://<POLARIS_HOST>:8181/api/catalog/v1/oauth/tokens

# STORAGE (pass 1 — own keys): Trino reaches S3 with its OWN AWS creds (the AWS_* env already passed
# to the container, same as the Nessie `iceberg` catalog). The catalog only brokers the metadata pointer.
fs.native-s3.enabled=true
s3.region=us-east-2

# Table S3 directory naming: Trino defaults iceberg.unique-table-location=true, which appends a random UUID
# suffix to each new table's S3 path (.../mytable-<uuid>). Safety measure — a recreated table never reuses a
# dropped table's prefix. Databricks-created tables use the clean location (.../mytable). Uncomment to make
# Trino write clean paths too (then restart Trino). Left OFF (default true) for now — suffix is safer.
#   iceberg.unique-table-location=false

# STORAGE (pass 2 — credential vending): to test Polaris vending instead, comment the two lines above and
# uncomment the next line (Polaris then vends short-lived scoped S3 creds; Trino needs no keys):
# iceberg.rest-catalog.vended-credentials-enabled=true
#
# If Polaris points at MinIO/RustFS instead of real S3: s3.endpoint=http://<MINIO_HOST>:9000 + s3.path-style-access=true
